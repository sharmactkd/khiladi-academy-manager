NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/khiladi_academy_manager
CLIENT_URL=http://localhost:5173

# Generate three independent random secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
DATA_ENCRYPTION_KEY=replace-with-an-independent-data-encryption-secret
AUDIT_LOG_SIGNING_KEY=replace-with-an-independent-audit-signing-secret
AUDIT_LOG_RETENTION_DAYS=365
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_COOKIE_NAME=khiladi_refresh_token
MAX_REFRESH_SESSIONS=5
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
TRUST_PROXY=false

# Exact comma-separated origins only. HTTPS is mandatory in production.
TOURNAMENT_API_ALLOWED_ORIGINS=http://localhost:5001

GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KHILADI Academy Manager <noreply@example.com>
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
FRONTEND_VERIFY_EMAIL_URL=http://localhost:5173/verify-email
# One-time migration cutoff. Set this to the deployment timestamp before running
# security:migrate-existing-users, then remove it after the migration.
EXISTING_USER_VERIFICATION_CUTOFF=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GST_PERCENTAGE=18
BILLING_GRACE_DAYS=7
